{
  "name": "mikumod-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "MikuMod Desktop - 模组管理与社区平台",
  "main": "electron/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "typecheck:electron": "tsc --project tsconfig.electron.json --noEmit",
    "electron:dev": "npm run dev",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "npm run preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.7.0",
    "node-forge": "^1.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.5"
  },
  "build": {
    "appId": "com.mikumod.desktop",
    "productName": "MikuMod",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "protocols": {
      "name": "MikuMod Protocol",
      "schemes": [
        "mikumod"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://cdn.mikumod.com/desktop/${channel}",
        "channel": "stable",
        "useMultipleRangeRequest": false
      }
    ]
  }
}
