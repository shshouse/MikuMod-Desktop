{
  "name": "mikumod-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "MikuMod Desktop - 模组管理与社区平台",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"cross-env BROWSER=none vite\" \"wait-on http://localhost:5177 && cross-env VITE_DEV_SERVER_URL=http://localhost:5177 electron .\"",
    "vite:dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "electron:dev": "npm run dev",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "cross-env VITE_DEV_SERVER_URL= electron ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "@tailwindcss/vite": "^4.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.7.0",
    "node-forge": "^1.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.mikumod.desktop",
    "productName": "MikuMod Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "protocols": {
      "name": "MikuMod Protocol",
      "schemes": [
        "mikumod"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mikumod",
        "repo": "MikuMod-Desktop"
      }
    ]
  }
}
